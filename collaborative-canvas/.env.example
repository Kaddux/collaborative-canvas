# Copy to .env in this directory (collaborative-canvas/) and fill in real values.
# .env is gitignored — never commit real secrets.
#
# POSTGRES_PASSWORD           shared by the Postgres container and the backend.
# WEBSOCKET_ALLOWED_ORIGINS   exact frontend origin(s), comma-separated. No wildcard.
# DOMAIN                      hostname nginx serves and requests a certificate for.
# LETSENCRYPT_EMAIL           contact email for Let's Encrypt expiry notices.

POSTGRES_PASSWORD=change-me-to-a-strong-password
WEBSOCKET_ALLOWED_ORIGINS=https://canvas.example.dev
DOMAIN=canvas.example.dev
LETSENCRYPT_EMAIL=you@example.com
